# 轻程序配置文件（云端站点前端访问云端测试环境函数模式，请勿手动修改）

# just a flag
ENV = 'test'

# 构建生产环境应用
NODE_ENV = production

# base api
VUE_APP_BASE_API = '/test-api'

# 若应用部署在根路径上，需要用 publicPath 指定为 '/'
# 若应用部署在一个子路径上，需要用 publicPath 指定这个子路径
# 若 publicPath 指定为 '' 或者 './' 时，所有资源都会被连接为相对路径，即打出来的包可以部署在任意路径下
# 当使用基于HTML5 history.pushState 的路由时或者使用 pages 选项构建多页应用时 应当避免使用相对路径
VUE_APP_PUBLIC_PATH = './'

# 当运行 npm run build:test 时生成的生产环境构建文件目录
VUE_APP_OUTPUT_DIR = 'dist_test'

# 放置生成的静态资源的（相对于 outputDir 的）目录
VUE_APP_ASSETS_DIR = 'static'

# 应用标题名称
VUE_APP_NAME = 'udesk-mobile-template-test'

# 云函数SDK调用参数
VUE_APP_QC_HOST = 'https://gd-qcloud.test.abchina.com.cn'

# 调用CDN加速(联系轻云配置不同环境cdn域名)
VUE_APP_QC_CDN_URL = 'http://nm-cdn-test.qcloud.test.abc'