{
  "name": "udesk-mobile-template",
  "qpenName": "mbankui-template",
  "qpcnName": "H5轻程序中文名",
  "qpisOfflineCfg": "00",
  "qpdescription": "默认H5轻程序简介",
  "qpkeywords": "H5轻程序查询关键词",
  "version": "5.5.11",
  "description": "统一客户端应用平台(UDesk)H5轻程序（移动）模板工程，供行内应用系统正式开发和投产使用。",
  "author": "UDesk,UMAP",
  "license": "MIT",
  "scripts": {
    "local": "node build/serve --open --mode predev",
    "dev": "node build/serve --open --mode development",
    "dev:env": "node build/serve",
    "build:preprod": "node build/build --mode preprod",
    "build:prod": "node build/build --mode production",
    "build:stage": "node build/build --mode staging",
    "build:test": "node build/build --mode test",
    "build:analyzer": "node build/index.js --analyzer",
    "preview": "node build/index.js --preview",
    "lint": "eslint --ext .js,.vue src",
    "lint:create": "eslint --init",
    "lint:report": "eslint -f stylish src --ext .js,.vue > eslintReport.txt",
    "test:unit": "vue-cli-service test:unit",
    "test:ci": "npm run lint && npm run test:unit",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
    "new": "plop",
    "package": "node zipDist"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "udesk",
    "mobile",
    "H5",
    "qprogram",
    "template",
    "Agricultural Bank of China"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@qcloud/client-sdk": "0.26.2",
    "@udesk/mbank-ui": "5.1.0-alpha.6",
    "@udesk/mobile-ui": "^5.1.0",
    "@udesk/mbank-ui-v2": "^1.2.8",
    "axios": "^0.30.0",
    "cube-ui": "~1.12.15",
    "echarts": "^4.9.0",
    "element-ui": "2.13.2",
    "html2canvas": "^1.0.0-rc.7",
    "js-cookie": "^2.2.1",
    "mint-ui": "^2.2.13",
    "normalize.css": "^7.0.0",
    "vant": "2.13.2",
    "vue": "2.6.12",
    "vue-router": "^3.0.2",
    "vuex": "^3.1.0",
    "@umap/heron": "^5.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/register": "^7.15.3",
    "@vue/cli-plugin-babel": "^3.5.3",
    "@vue/cli-plugin-unit-jest": "^4.5.12",
    "@vue/cli-service": "4.5.17",
    "@vue/test-utils": "^1.0.0-beta.29",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.0.3",
    "babel-jest": "^24.8.0",
    "chalk": "^2.4.2",
    "connect": "^3.6.6",
    "eslint": "7.32.0",
    "eslint-plugin-vue": "0.0.1-abcalpha.1",
    "html-webpack-plugin": "^3.2.0",
    "husky": "^7.0.1",
    "less": "^3.10.3",
    "less-loader": "^5.0.0",
    "mockjs": "^1.0.1-beta3",
    "plop": "^2.3.0",
    "postcss-pxtorem": "^4.0.1",
    "sass-loader": "^8.0.0",
    "sass": "1.47.0",
    "script-ext-html-webpack-plugin": "^2.1.3",
    "script-loader": "^0.7.2",
    "serve-static": "^1.13.2",
    "stylus": "^0.54.7",
    "stylus-loader": "^3.0.2",
    "svg-sprite-loader": "^4.1.3",
    "svgo": "2.3.1",
    "vue-cli-plugin-cube-ui": "^0.2.5",
    "vue-template-compiler": "2.6.12",
    "webpack-bundle-analyzer": "^4.2.0",
    "zip-dir": "^2.0.0"
  },
  "engines": {
    "node": ">= 8.9",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "transformModules": {
    "cube-ui": {
      "transform": "cube-ui/src/modules/${member}",
      "kebabCase": true
    }
  }
}
